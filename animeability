local function isUsingSkill()
    local now = os.clock()
    if now - lastSkillUseTick < 0.45 then return true end
    if activeSkillTrack and activeSkillTrack.IsPlaying then
        if now - lastSkillUseTick < 3.5 then return true
        else activeSkillTrack = nil end
    end
    if now < currentSkillEndTime then return true end
    return false
end

