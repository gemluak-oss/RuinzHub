-- ============================================
-- FIX: FUNGSI TOGGLE UI (BUKA/TUTUP)
-- ============================================
local uiVisible = true
local lastToggleTime = 0
local cachedMainFrame = nil

local function findWindUIFrame()
    if cachedMainFrame and cachedMainFrame.Parent then
        return cachedMainFrame
    end
    for _, gui in ipairs(CoreGui:GetChildren()) do
        if gui:IsA("ScreenGui") and (gui.Name:lower():find("wind") or gui.Name:lower():find("ruinz") or gui.Name:lower():find("hub")) then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("Frame") and obj.Name == "Topbar" then
                    local main = obj.Parent
                    if main and main:IsA("Frame") then
                        cachedMainFrame = main
                        return main
                    end
                end
            end
        end
    end
    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pGui then
        for _, gui in ipairs(pGui:GetChildren()) do
            if gui:IsA("ScreenGui") and (gui.Name:lower():find("wind") or gui.Name:lower():find("ruinz")) then
                for _, obj in ipairs(gui:GetDescendants()) do
                    if obj:IsA("Frame") and obj.Name == "Topbar" then
                        local main = obj.Parent
                        if main and main:IsA("Frame") then
                            cachedMainFrame = main
                            return main
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function toggleUI()
    local now = tick()
    if now - lastToggleTime < 0.3 then return end
    lastToggleTime = now
    uiVisible = not uiVisible

    local success = false
    pcall(function()
        if Window then
            if Window.Toggle then
                Window:Toggle()
                success = true
            elseif Window.SetVisible then
                Window:SetVisible(uiVisible)
                success = true
            elseif uiVisible and Window.Open then
                Window:Open()
                success = true
            elseif not uiVisible and Window.Close then
                Window:Close()
                success = true
            end
        end
    end)

    if not success then
        local frame = findWindUIFrame()
        if frame then
            frame.Visible = uiVisible
            if frame.Parent and frame.Parent:IsA("GuiObject") then
                frame.Parent.Visible = uiVisible
            end
            for _, child in ipairs(frame:GetChildren()) do
                if child:IsA("GuiObject") then
                    child.Visible = uiVisible
                end
            end
        end
    end
end

-- ============================================
-- FIX: KLIK LOGO = TOGGLE UI (ANTI-BENTROK DRAG)
-- ============================================
local logoClickStart = Vector2.new()

LogoBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        logoClickStart = Vector2.new(input.Position.X, input.Position.Y)
    end
end)

LogoBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local dist = (Vector2.new(input.Position.X, input.Position.Y) - logoClickStart).Magnitude
        -- Klik hanya kalau tidak geser (dist < 10) DAN tidak ada drag
        if dist < 10 and not logoDragMoved then
            toggleUI()
        end
        logoDragMoved = false
    end
end)

-- ============================================
-- FIX: KEYBIND BUKA UI (RightControl / F1)
-- ============================================
UserInputService.InputBegan:Connect(function(input, processed)
    if UserInputService:GetFocusedTextBox() then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Enum.KeyCode.RightControl or input.KeyCode == Enum.KeyCode.F1 then
            toggleUI()
        end
    end
end)

